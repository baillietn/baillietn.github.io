<!DOCTYPE html>
<!-- Generated from _cv/cv.yml by ./generate-cv.sh. Do not edit by hand: edit the content or _cv/templates/. -->
<html lang="en">
{% from 'flags.html.j2' import flag %}
{% set levels = {'Advanced': 'sl-adv', 'Proficient': 'sl-prof', 'Intermediate': 'sl-int'} %}

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ cv.meta.title }}</title>
    <meta name="description" content="{{ cv.meta.description }}">
    <meta property="og:title" content="{{ cv.meta.og_title }}">
    <meta property="og:description" content="{{ cv.meta.og_description }}">
    <meta property="og:image" content="{{ cv.meta.og_image }}">
    <meta property="og:url" content="{{ cv.meta.url }}">
    <meta property="og:type" content="website">
    <meta name="twitter:card" content="summary_large_image">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Schibsted+Grotesk:wght@400;500;600;700;800&family=IBM+Plex+Mono:wght@400;500&display=swap">
    <link rel="stylesheet" href="style.css?v=6">
    <style>
        {% filter indent(8) %}
        {% include 'plain.css' %}
        {% endfilter %}
    </style>
</head>

<body>
    <div class="btn-container">
        <a href="../index.html" class="cv-btn">← Portfolio</a>
        <button class="theme-toggle-cv" onclick="toggleTheme()" aria-label="Toggle dark/light mode">
            <span class="icon-moon">🌙</span>
            <span class="icon-sun">☀️</span>
        </button>
    </div>

    <div class="btn-container-right">
        <a href="https://linkedin.com/in/nbailliet" target="_blank" rel="noopener noreferrer" title="LinkedIn"
            class="linkedin-btn">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path
                    d="M20.447 20.452h-3.554v-5.569c0-1.328-.475-2.236-1.986-2.236-1.081 0-1.722.722-2.004 1.418-.103.249-.129.597-.129.945v5.442h-3.554s.05-8.824 0-9.736h3.554v1.375c.427-.659 1.191-1.599 2.896-1.599 2.117 0 3.704 1.383 3.704 4.357v5.603zM5.337 8.855c-1.144 0-1.915-.758-1.915-1.707 0-.953.77-1.708 1.963-1.708 1.192 0 1.914.755 1.938 1.708 0 .949-.746 1.707-1.986 1.707zm1.582 11.597H3.635V9.716h3.284v10.736zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.225 0z" />
            </svg>
        </a>
        <button class="download-btn" onclick="downloadPDF()">📥 Download PDF</button>
        <div class="view-switch" role="group" aria-label="CV version">
            <button class="view-option" data-view="design" onclick="setView('design')">Design</button>
            <button class="view-option" data-view="letter" onclick="setView('letter')">US Letter</button>
        </div>
    </div>

    {% macro icon(name) %}
    {% if name == 'phone' %}
    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2z"></path></svg>
    {% elif name == 'email' %}
    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="2"></rect><path d="m22 7-10 6L2 7"></path></svg>
    {% elif name == 'location' %}
    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s7-6.1 7-12a7 7 0 0 0-14 0c0 5.9 7 12 7 12z"></path><circle cx="12" cy="10" r="2.5"></circle></svg>
    {% elif name == 'github' %}
    <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.3 3.44 9.8 8.2 11.39.6.1.83-.26.83-.58v-2.23c-3.34.73-4.03-1.42-4.03-1.42-.55-1.39-1.33-1.76-1.33-1.76-1.09-.74.08-.73.08-.73 1.2.09 1.84 1.24 1.84 1.24 1.07 1.83 2.81 1.3 3.5 1 .1-.78.42-1.31.76-1.61-2.67-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.13-.3-.54-1.52.12-3.18 0 0 1-.32 3.3 1.23a11.5 11.5 0 0 1 6 0c2.28-1.55 3.29-1.23 3.29-1.23.66 1.66.25 2.88.12 3.18.77.84 1.24 1.91 1.24 3.22 0 4.61-2.81 5.62-5.48 5.92.43.37.81 1.1.81 2.22v3.29c0 .32.22.69.83.57C20.57 21.8 24 17.3 24 12c0-6.63-5.37-12-12-12z"></path></svg>
    {% elif name == 'linkedin' %}
    <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.94v5.67H9.36V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0z"></path></svg>
    {% elif name == 'hf' %}
    <span aria-hidden="true" class="hf-badge">HF</span>
    {% else %}
    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="M2 12h20M12 2a15 15 0 0 1 0 20M12 2a15 15 0 0 0 0 20"></path></svg>
    {% endif %}
    {% endmacro %}

    {# An education entry may give `degree` and `school` instead of a `title`: the designed CV
       shows "degree — school", followed by the city when the school name does not already include it. #}
    {% macro entry_title(entry) %}{% if entry.degree %}{{ entry.degree }} — {{ entry.school }}{% if entry.location and entry.location not in entry.school %}, {{ entry.location }}{% endif %}{% else %}{{ entry.title }}{% endif %}{% endmacro %}

    <div class="cv-container">
        <aside class="sidebar">
            <img class="cv-photo" src="../{{ cv.identity.photo }}" alt="{{ cv.identity.name }}">

            <p class="side-pill"><span aria-hidden="true" class="dot"></span>{{ cv.availability.badge }}</p>

            <section class="side-section">
                <h2>Contact</h2>
                <ul class="contact-list">
                    {% if cv.identity.phone %}
                    <li>{{ icon('phone') | indent(20) }}<span>{{ cv.identity.phone }}</span></li>
                    {% endif %}
                    {% set email_user, email_domain = cv.identity.email.split('@') %}
                    <li>{{ icon('email') | indent(20) }}<a href="mailto:{{ cv.identity.email }}">{{ email_user }}@<br>{{ email_domain }}</a></li>
                    <li>{{ icon('location') | indent(20) }}<span>{{ cv.identity.location }}</span></li>
                    {% for link in cv.identity.links %}
                    <li>{{ icon(link.id) | indent(20) }}<a href="{{ link.url }}">{{ link.label }}</a></li>
                    {% endfor %}
                </ul>
            </section>

            <section class="side-section skills">
                <h2>Skills</h2>
                {% for group in cv.skills %}
                <h3 class="skill-group">{{ group.category }}</h3>
                {% if group['items'] | selectattr('level', 'defined') | list %}
                <ul class="skill-rows">
                    {% for item in group['items'] %}
                    <li><span>{{ item.name }}</span><span class="skill-level {{ levels[item.level] }}">{{ item.level }}</span></li>
                    {% endfor %}
                </ul>
                {% else %}
                <ul class="tool-chips">
                    {% for item in group['items'] %}
                    <li>{{ item }}</li>
                    {% endfor %}
                </ul>
                {% endif %}
                {% endfor %}
            </section>

            <section class="side-section">
                <h2>Languages</h2>
                <ul class="lang-list">
                    {% for language in cv.languages %}
                    <li>
                        {{ flag(language.code) | indent(24) }}
                        <span><strong>{{ language.name }}:</strong> {{ language.level }}</span>
                    </li>
                    {% endfor %}
                </ul>
            </section>
        </aside>

        <div class="main-content">

            <header class="cv-header">
                <h1>{{ cv.identity.name }}</h1>
                <p class="cv-role">{{ cv.identity.title }}</p>
                <div class="cv-pills">
                    <p class="cv-pill"><span aria-hidden="true" class="dot"></span>{{ cv.availability.seeking }} · {{ cv.availability.based_in }} · {{ cv.availability.mobility }}</p>
                    <p class="cv-pill"><span aria-hidden="true" class="dot"></span>{{ cv.availability.focus }}</p>
                </div>
            </header>

            {# Every section of cv.yml, in order: a paragraph, dated entries, or project cards. #}
            {% for section in cv.sections %}
            <section class="cv-section">
                <h2>{{ section.title }}</h2>
                {% if section.text %}
                <p class="cv-profile">{{ section.text | inline }}</p>
                {% endif %}

                {% if section.style == 'projects' %}
                {% for entry in section.entries if entry.featured %}
                <div class="featured">
                    <div class="featured-head">
                        <strong>★ {{ entry.title }}</strong>
                        <div class="featured-links">
                            {% for link in entry.links %}
                            <span><a href="{{ link.url }}">{{ link.label }} ↗</a> <span class="url">{{ link.display }}</span></span>
                            {% endfor %}
                        </div>
                    </div>
                    {% if entry.metrics %}
                    <div class="metrics">
                        {% for metric in entry.metrics %}
                        <span>{{ metric }}</span>
                        {% endfor %}
                    </div>
                    {% endif %}
                    {% if entry.tech %}
                    <span class="tech">{{ entry.tech | join(' · ') }}</span>
                    {% endif %}
                    {% if entry.description %}
                    <p class="project-desc">{{ entry.description | inline }}</p>
                    {% endif %}
                </div>
                {% endfor %}
                {% set others = section.entries | rejectattr('featured') | list %}
                {% if others %}
                <div class="other-projects">
                    {% for entry in others %}
                    <div class="project">
                        <strong>{{ entry.title }}</strong>
                        {% if entry.tech %}
                        <span class="tech">{{ entry.tech | join(' · ') }}</span>
                        {% endif %}
                        {% if entry.description %}
                        <p class="project-desc">{{ entry.description | inline }}</p>
                        {% endif %}
                    </div>
                    {% endfor %}
                </div>
                {% endif %}

                {% elif section.entries %}
                <div class="entries">
                    {% for entry in section.entries %}
                    <div class="entry{% if entry.bullets %} has-bullets{% endif %}">
                        <div class="entry-head">
                            <strong>{{ entry_title(entry) }}</strong>
                            {% if entry.start %}
                            <span class="entry-date">{{ dates(entry.start, entry.end) }}</span>
                            {% endif %}
                        </div>
                        {% if entry.organization %}
                        <span class="entry-sub">{{ [entry.organization, entry.location] | select | join(' · ') }}</span>
                        {% endif %}
                        {% if entry.tech %}
                        <span class="tech">{{ entry.tech | join(' · ') }}</span>
                        {% endif %}
                        {% if entry.description %}
                        <span class="entry-desc">{{ entry.description | inline }}</span>
                        {% endif %}
                        {% if entry.bullets %}
                        <ul>
                            {% for bullet in entry.bullets %}
                            <li>{{ bullet | inline }}</li>
                            {% endfor %}
                        </ul>
                        {% endif %}
                    </div>
                    {% endfor %}
                </div>
                {% endif %}
            </section>
            {% endfor %}

        </div>
    </div>

    {# Preview of the US Letter version: the same HTML that is printed to its PDF. #}
    <div class="letter-sheet">
        {{ letter_body | indent(8) }}
    </div>

    <script>
        const root = document.documentElement;

        function applyTheme() {
            const stored = localStorage.getItem('theme');
            if (stored) {
                root.setAttribute('data-theme', stored);
            } else {
                const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
                if (prefersDark) root.setAttribute('data-theme', 'dark');
            }
        }

        applyTheme();

        window.addEventListener('storage', (e) => {
            if (e.key === 'theme' && e.newValue) {
                root.setAttribute('data-theme', e.newValue);
            }
        });

        window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', (e) => {
            if (!localStorage.getItem('theme')) {
                root.setAttribute('data-theme', e.matches ? 'dark' : 'light');
            }
        });

        window.addEventListener('beforeprint', () => {
            root.removeAttribute('data-theme');
        });
        window.addEventListener('afterprint', () => {
            applyTheme();
        });

        function toggleTheme() {
            const current = root.getAttribute('data-theme');
            const next = current === 'dark' ? 'light' : 'dark';
            root.setAttribute('data-theme', next);
            localStorage.setItem('theme', next);
        }

        // Two versions of the CV: the designed one and the plain US Letter one.
        const PDF_FILES = { design: 'cv-nicolas-bailliet.pdf', letter: 'cv-nicolas-bailliet-us-letter.pdf' };

        function setView(view) {
            root.setAttribute('data-view', view);
            document.querySelectorAll('.view-option').forEach(b => b.setAttribute('aria-pressed', b.dataset.view === view));
            history.replaceState(null, '', view === 'letter' ? '#us-letter' : location.pathname + location.search);
        }

        setView(location.hash === '#us-letter' ? 'letter' : 'design');

        function downloadPDF() {
            const btn = document.querySelector('.download-btn');
            const orig = btn.textContent;
            const file = PDF_FILES[root.getAttribute('data-view')];
            btn.disabled = true;
            btn.textContent = '⏳ Downloading...';
            fetch(file)
                .then(r => { if (!r.ok) throw new Error('PDF not found'); return r.blob(); })
                .then(blob => {
                    const url = URL.createObjectURL(blob);
                    const a = document.createElement('a');
                    a.href = url; a.download = file;
                    document.body.appendChild(a); a.click();
                    URL.revokeObjectURL(url); document.body.removeChild(a);
                    btn.textContent = orig; btn.disabled = false;
                })
                .catch(() => {
                    btn.textContent = '❌ Error';
                    setTimeout(() => { btn.textContent = orig; btn.disabled = false; }, 2000);
                });
        }
    </script>
</body>

</html>
