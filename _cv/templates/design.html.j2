<!DOCTYPE html>
<!-- Generated from _cv/cv.yml by ./generate-cv.sh. Do not edit by hand: edit the content or _cv/templates/. -->
<html lang="en">
{% from 'flags.html.j2' import flag %}
{% set levels = {'Advanced': 'sl-adv', 'Proficient': 'sl-prof', 'Intermediate': 'sl-int'} %}

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ cv.meta.title }}</title>
    <meta name="description" content="{{ cv.meta.description }}">
    <meta property="og:title" content="{{ cv.meta.og_title }}">
    <meta property="og:description" content="{{ cv.meta.og_description }}">
    <meta property="og:image" content="{{ cv.meta.og_image }}">
    <meta property="og:url" content="{{ cv.meta.url }}">
    <meta property="og:type" content="website">
    <meta name="twitter:card" content="summary_large_image">
    <link rel="stylesheet" href="style.css?v=4">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.10/dist/katex.min.css">
    <script src="https://cdn.jsdelivr.net/npm/katex@0.16.10/dist/katex.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/katex@0.16.10/dist/contrib/auto-render.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            renderMathInElement(document.body, {
                delimiters: [
                    { left: '$$', right: '$$', display: true },
                    { left: '$', right: '$', display: false }
                ]
            });
        });
    </script>
</head>

<body>
    <div class="btn-container">
        <a href="../index.html" class="cv-btn">← Portfolio</a>
        <button class="theme-toggle-cv" onclick="toggleTheme()" aria-label="Toggle dark/light mode">
            <span class="icon-moon">🌙</span>
            <span class="icon-sun">☀️</span>
        </button>
    </div>

    <div class="btn-container-right">
        <a href="https://linkedin.com/in/nbailliet" target="_blank" rel="noopener noreferrer" title="LinkedIn"
            class="linkedin-btn">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path
                    d="M20.447 20.452h-3.554v-5.569c0-1.328-.475-2.236-1.986-2.236-1.081 0-1.722.722-2.004 1.418-.103.249-.129.597-.129.945v5.442h-3.554s.05-8.824 0-9.736h3.554v1.375c.427-.659 1.191-1.599 2.896-1.599 2.117 0 3.704 1.383 3.704 4.357v5.603zM5.337 8.855c-1.144 0-1.915-.758-1.915-1.707 0-.953.77-1.708 1.963-1.708 1.192 0 1.914.755 1.938 1.708 0 .949-.746 1.707-1.986 1.707zm1.582 11.597H3.635V9.716h3.284v10.736zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.225 0z" />
            </svg>
        </a>
        <button class="download-btn" onclick="downloadPDF()">📥 Download PDF</button>
    </div>

    <div class="cv-container">
        <div class="sidebar">
            <div class="profile-photo">
                <img src="../{{ cv.identity.photo }}" alt="{{ cv.identity.name }}">
            </div>

            <div class="avail-badge">
                <span class="avail-dot"></span>
                {{ cv.availability.badge }}
            </div>

            <div>
                <h3>Contact</h3>
                <div class="contact-info">
                    {% if cv.identity.phone %}
                    <p><span class="contact-icon phone"></span>{{ cv.identity.phone }}</p>
                    {% endif %}
                    {% set email_user, email_domain = cv.identity.email.split('@') %}
                    <p><span class="contact-icon email"></span>
                        <a href="mailto:{{ cv.identity.email }}">{{ email_user }}@<br>{{ email_domain }}</a>
                    </p>
                    <p><span class="contact-icon location"></span>{{ cv.identity.location }}</p>
                    {% for link in cv.identity.links %}
                    <p><span class="contact-icon {{ link.id }}"></span>
                        <a href="{{ link.url }}">{{ link.label }}</a>
                    </p>
                    {% endfor %}
                </div>
            </div>

            <div class="sidebar-divided">
                <h3>Skills</h3>

                {# Flat on purpose: labels, rows and badges are siblings in the layout. #}
                {% for group in cv.skills %}
                <div class="skill-group-label">{{ group.category }}</div>
                {% if group['items'] | selectattr('level', 'defined') | list %}
                {% for item in group['items'] %}
                <div class="skill-row"><span class="skill-name">{{ item.name }}</span><span class="skill-level {{ levels[item.level] }}">{{ item.level }}</span></div>
                {% endfor %}
                {% else %}
                <div class="tech-mini">
                    {% for item in group['items'] %}
                    <span class="tech-badge">{{ item }}</span>
                    {% endfor %}
                </div>
                {% endif %}
                {% endfor %}
            </div>
            <div>
                <h3>Languages</h3>
                <div class="languages">
                    {% for language in cv.languages %}
                    <div class="lang-row">
                        {{ flag(language.code) | indent(24) }}
                        <span><strong>{{ language.name }}:</strong> {{ language.level }}</span>
                    </div>
                    {% endfor %}
                </div>
            </div>
        </div>

        <div class="main-content">

            <div class="header">
                <div class="name">{{ cv.identity.name }}</div>
                <div class="title-line">{{ cv.identity.title }}</div>
                <div class="avail-row">
                    <div class="avail-inline">
                        <span class="avail-inline-dot"></span>
                        {{ cv.availability.seeking }} · {{ cv.availability.location_note }}
                    </div>
                    <div class="avail-inline">
                        <span class="avail-inline-dot"></span>
                        {{ cv.availability.focus }}
                    </div>
                </div>
            </div>

            {# Every section of cv.yml, in order: a paragraph, dated entries, or project cards. #}
            {% for section in cv.sections %}
            <div class="section">
                <div class="section-title">{{ section.title }}</div>
                {% if section.text %}
                <p class="profile-text">{{ section.text | inline }}</p>
                {% endif %}

                {% for entry in section.entries %}
                {% if section.style == 'projects' %}
                <div class="project-item">
                    {% if entry.featured %}
                    <div class="project-header">
                        <div class="project-title">★ {{ entry.title }}</div>
                        <div class="project-links">
                            {% for link in entry.links %}
                            <div class="project-link-item">
                                <a href="{{ link.url }}" class="project-link">{{ link.label }} ↗</a>
                                <span class="project-url">({{ link.display }})</span>
                            </div>
                            {% endfor %}
                        </div>
                    </div>
                    {% else %}
                    <div class="project-name">{{ entry.title }}</div>
                    {% endif %}
                    {% if entry.metrics %}
                    <div class="project-metrics">
                        {% for metric in entry.metrics %}
                        <span class="metric-chip">{{ metric }}</span>
                        {% endfor %}
                    </div>
                    {% endif %}
                    {% if entry.tech %}
                    <div class="project-tech">{{ entry.tech | join(' · ') }}</div>
                    {% endif %}
                    {% if entry.description %}
                    <div class="project-desc">{{ entry.description | inline }}</div>
                    {% endif %}
                </div>
                {% else %}
                <div class="entry">
                    <div class="entry-header">
                        <div class="entry-title">{{ entry.title }}</div>
                        {% if entry.start %}
                        <div class="entry-date">{{ dates(entry.start, entry.end) }}</div>
                        {% endif %}
                    </div>
                    {% if entry.organization or entry.location %}
                    <div class="entry-sub">{{ [entry.organization, entry.location] | select | join(' · ') }}</div>
                    {% endif %}
                    {% if entry.tech %}
                    <div class="entry-tech">{{ entry.tech | join(' · ') }}</div>
                    {% endif %}
                    {% if entry.description %}
                    <div class="entry-desc">{{ entry.description | inline }}</div>
                    {% endif %}
                    {% if entry.bullets %}
                    <div class="entry-desc">
                        <ul>
                            {% for bullet in entry.bullets %}
                            <li>{{ bullet | inline }}</li>
                            {% endfor %}
                        </ul>
                    </div>
                    {% endif %}
                </div>
                {% endif %}
                {% endfor %}
            </div>
            {% endfor %}

        </div>
    </div>

    <script>
        const root = document.documentElement;

        function applyTheme() {
            const stored = localStorage.getItem('theme');
            if (stored) {
                root.setAttribute('data-theme', stored);
            } else {
                const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
                if (prefersDark) root.setAttribute('data-theme', 'dark');
            }
        }

        applyTheme();

        window.addEventListener('storage', (e) => {
            if (e.key === 'theme' && e.newValue) {
                root.setAttribute('data-theme', e.newValue);
            }
        });

        window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', (e) => {
            if (!localStorage.getItem('theme')) {
                root.setAttribute('data-theme', e.matches ? 'dark' : 'light');
            }
        });

        window.addEventListener('beforeprint', () => {
            root.removeAttribute('data-theme');
        });
        window.addEventListener('afterprint', () => {
            applyTheme();
        });

        function toggleTheme() {
            const current = root.getAttribute('data-theme');
            const next = current === 'dark' ? 'light' : 'dark';
            root.setAttribute('data-theme', next);
            localStorage.setItem('theme', next);
        }

        function downloadPDF() {
            const btn = document.querySelector('.download-btn');
            const orig = btn.textContent;
            btn.disabled = true;
            btn.textContent = '⏳ Downloading...';
            fetch('cv-nicolas-bailliet.pdf')
                .then(r => { if (!r.ok) throw new Error('PDF not found'); return r.blob(); })
                .then(blob => {
                    const url = URL.createObjectURL(blob);
                    const a = document.createElement('a');
                    a.href = url; a.download = 'cv-nicolas-bailliet.pdf';
                    document.body.appendChild(a); a.click();
                    URL.revokeObjectURL(url); document.body.removeChild(a);
                    btn.textContent = orig; btn.disabled = false;
                })
                .catch(() => {
                    btn.textContent = '❌ Error';
                    setTimeout(() => { btn.textContent = orig; btn.disabled = false; }, 2000);
                });
        }
    </script>
</body>

</html>
